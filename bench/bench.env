# Settings for the benchmark API, shared by docker-compose.yml (env_file) and env.sh (sourced).
# One load generator is one IP and one key per site, so the default public and login rate limits would
# answer 429 straight away. Delete the *_LIMIT lines to measure with the defaults.
ENVIRONMENT=development
JWT_SECRET=bench-secret-bench-secret-bench-secret-123
ACCESS_TOKEN_MINUTES=240
REDIS_URL=
PUBLIC_IP_LIMIT=10000000
PUBLIC_KEY_LIMIT=10000000
LOGIN_IP_LIMIT=10000
LOGIN_ACCOUNT_LIMIT=10000
