{
  "name": "loupebox-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && tsc --noEmit && vite build && npm run build:widget",
    "preview": "vite preview",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "build:widget": "tsc -p tsconfig.widget.json --noEmit false && vite build -c vite.widget.config.ts",
    "test": "npm run build:widget && node --test \"widget/test/*.test.mjs\""
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
