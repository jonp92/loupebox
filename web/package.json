{
  "name": "loupebox-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:widget",
    "preview": "vite preview",
    "build:widget": "tsc -p tsconfig.widget.json --noEmit false && vite build -c vite.widget.config.ts",
    "test": "npm run build:widget && node --test \"widget/test/*.test.mjs\""
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
