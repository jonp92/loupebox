# --- Required for docker compose and for running locally ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Use URL-safe characters only (letters, digits, - _ .): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Encrypts two-factor secrets in the database. Optional: falls back to JWT_SECRET, but then
# rotating JWT_SECRET would lock out everyone using two-factor. Set it once and keep it.
TOTP_ENCRYPTION_KEY=
# Encrypts webhook signing secrets. Same advice, and a different key on purpose.
WEBHOOK_ENCRYPTION_KEY=

# --- Running the API on the host (not in Docker): must use the same password as above ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ganymede:CHANGE_ME@localhost:5432/ganymede
ADMIN_ORIGINS=["http://localhost:5173"]

# --- Docker compose overrides (optional) ---
# Host ports (always bound to 127.0.0.1; container ports are fixed). Change if a port is taken,
# and keep deploy/Caddyfile's upstreams in sync.
# DB_PORT=5432
# API_PORT=8000
# WEB_PORT=8080
# ADMIN_ORIGINS=["https://feedback-admin.example.com"]   # the origin(s) serving the web UI
# API_URL=https://feedback.example.com                   # API origin the browser calls (no path; the UI adds /v1/api)
# COOKIE_SECURE=true                                      # when serving over HTTPS
# COOKIE_SAMESITE=lax                                     # "none" if UI and API are on different sites
# TRUST_PROXY=true                                        # when behind a reverse proxy

# --- Notifications (email via Brevo; used by the worker: python -m app.worker) ---
# BREVO_API_KEY=xkeysib-...
# NOTIFY_SENDER_EMAIL=feedback@example.com   # must be a verified sender in Brevo
# NOTIFY_SENDER_NAME=Ganymede
# Or send through plain SMTP instead of Brevo (docs/SMTP_SETUP.md); NOTIFY_SENDER_* above still apply:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls                      # starttls, ssl or none (none never sends a password)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# PUBLIC_URL=https://feedback-admin.example.com   # admin UI origin, for links in emails (also needed for "Forgot password?")
# PASSWORD_RESET_MINUTES=30   # how long an emailed reset link works
# NOTIFY_HOURLY_CAP=5                         # emails per channel per hour; overflow becomes one summary
# NOTIFY_RETENTION_DAYS=30                    # delete sent/failed outbox rows after this many days
# AUDIT_RETENTION_DAYS=365                    # delete audit log events after this many days (0 = keep forever)
