# Copy to .env on the server and fill in the two secrets. Used by docker-compose.yml.
ENVIRONMENT=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# URL-safe characters only (it is embedded in DATABASE_URL): python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# Encrypts two-factor secrets in the database. Required in production (elsewhere it falls back to
# JWT_SECRET, and rotating that would lock out everyone using two-factor). Set it once and keep it.
TOTP_ENCRYPTION_KEY=
# Encrypts webhook signing secrets. Same advice, and a different key on purpose.
WEBHOOK_ENCRYPTION_KEY=
# Encrypts email passwords and keys saved on the System settings page. Same advice.
SETTINGS_ENCRYPTION_KEY=

# Host ports Caddy proxies to (127.0.0.1 only). Keep deploy/Caddyfile's upstreams in sync.
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432

# Keep the database in this folder instead of a Docker volume. Set it before the first start; see the backups docs.
# DB_DATA_DIR=./pgdata

# Same origin for UI and API (see deploy/Caddyfile). API_URL is the origin only; the UI adds /v1/api.
API_URL=https://feedback.example.com
ADMIN_ORIGINS=["https://feedback.example.com"]
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Caddy sets X-Forwarded-For to the real client IP; containers listen on localhost only.
TRUST_PROXY=true

# Notifications (see https://loupebox.dev/notifications/brevo/). The worker service sends; the API needs these too for test-send.
BREVO_API_KEY=
NOTIFY_SENDER_EMAIL=
NOTIFY_SENDER_NAME=Loupebox
# Or plain SMTP instead of Brevo (see https://loupebox.dev/notifications/smtp/); leave BREVO_API_KEY empty to use it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Admin UI origin, used for links in emails.
PUBLIC_URL=https://feedback.example.com
NOTIFY_HOURLY_CAP=5

# Audit log: events older than this are purged by the worker (0 keeps them forever).
AUDIT_RETENTION_DAYS=365
