# Copy to .env on the server and fill in the two secrets. Used by docker-compose.yml.
ENVIRONMENT=production
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# URL-safe characters only (it is embedded in DATABASE_URL): python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# Encrypts two-factor secrets in the database. Optional: falls back to JWT_SECRET, but then
# rotating JWT_SECRET would lock out everyone using two-factor. Set it once and keep it.
TOTP_ENCRYPTION_KEY=

# Host ports Caddy proxies to (127.0.0.1 only). Keep deploy/Caddyfile's upstreams in sync.
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432

# Same origin for UI and API (see deploy/Caddyfile). API_URL is the origin only; the UI adds /v1/api.
API_URL=https://feedback.pressler.tech
ADMIN_ORIGINS=["https://feedback.pressler.tech"]
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Caddy sets X-Forwarded-For to the real client IP; containers listen on localhost only.
TRUST_PROXY=true

# Notifications (see docs/BREVO_SETUP.md). The worker service sends; the API needs these too for test-send.
BREVO_API_KEY=
NOTIFY_SENDER_EMAIL=
NOTIFY_SENDER_NAME=Ganymede
# Admin UI origin, used for links in emails.
PUBLIC_URL=https://feedback.pressler.tech
NOTIFY_HOURLY_CAP=5

# Audit log: events older than this are purged by the worker (0 keeps them forever).
AUDIT_RETENTION_DAYS=365
